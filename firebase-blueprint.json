{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "A company in the multi-tenant system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "forumVirtualHorizonMonths": { "type": "number" }
          }
        }
      },
      "required": ["id", "name", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "supervisor", "user", "lean_promotor"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "companyId": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "Team": {
      "title": "Team",
      "description": "A team of users",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "supervisorId": { "type": "string" },
        "supervisorName": { "type": "string" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uid": { "type": "string" },
              "name": { "type": "string" },
              "photoURL": { "type": "string" }
            }
          }
        },
        "processIds": { "type": "array", "items": { "type": "string" } },
        "parentTeamId": { "type": "string" },
        "companyId": { "type": "string" },
        "hasGroups": { "type": "boolean" },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "leaderId": { "type": "string" },
              "leaderName": { "type": "string" },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uid": { "type": "string" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "required": ["name", "supervisorId", "companyId"]
    },
    "Activity": {
      "title": "Activity",
      "description": "An activity grouping processes",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "companyId": { "type": "string" }
      },
      "required": ["name", "companyId"]
    },
    "Process": {
      "title": "Process",
      "description": "A process containing tasks",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "activityId": { "type": "string" },
        "order": { "type": "number" },
        "companyId": { "type": "string" }
      },
      "required": ["name", "description", "companyId"]
    },
    "Task": {
      "title": "Task",
      "description": "A task within a process",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "processId": { "type": "string" },
        "activityId": { "type": "string" },
        "criteriaId": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "companyId": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "processId", "criteriaId", "attachments", "companyId"]
    },
    "Criterion": {
      "title": "Criterion",
      "description": "Criteria for evaluating a task",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": { "type": "number" },
              "description": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "description": { "type": "string" }
                  },
                  "required": ["id", "description"]
                }
              }
            },
            "required": ["level", "description", "items"]
          }
        },
        "companyId": { "type": "string" }
      },
      "required": ["name", "levels", "companyId"]
    },
    "UserTaskLevel": {
      "title": "UserTaskLevel",
      "description": "A user's level for a specific task",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "taskId": { "type": "string" },
        "currentLevel": { "type": "number" },
        "targetLevel": { "type": "number" },
        "plannedLevel": { "type": "number" },
        "completedItems": { "type": "array", "items": { "type": "string" } },
        "selfLevel": { "type": "number" },
        "selfCompletedItems": { "type": "array", "items": { "type": "string" } },
        "companyId": { "type": "string" }
      },
      "required": ["userId", "taskId", "currentLevel", "targetLevel", "plannedLevel", "completedItems", "companyId"]
    },
    "TrainingAction": {
      "title": "TrainingAction",
      "description": "A training action for a user to reach a target level",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "taskId": { "type": "string" },
        "targetLevel": { "type": "number" },
        "trainerId": { "type": "string" },
        "plannedDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["planificada", "retrasada", "completada", "verificada"] },
        "verifierId": { "type": "string" },
        "verifierName": { "type": "string" },
        "verificationDate": { "type": "string" },
        "description": { "type": "string" },
        "companyId": { "type": "string" }
      },
      "required": ["userId", "taskId", "targetLevel", "trainerId", "plannedDate", "status", "companyId"]
    },
    "TeamTarget": {
      "title": "TeamTarget",
      "description": "Target number of people per level for a task in a team",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "processId": { "type": "string" },
        "taskId": { "type": "string" },
        "targetCounts": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "companyId": { "type": "string" }
      },
      "required": ["teamId", "processId", "taskId", "targetCounts", "companyId"]
    },
    "ActionPlan": {
      "title": "ActionPlan",
      "description": "An action plan item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["accion", "incidencia"] },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "assignedTo": { "type": "array", "items": { "type": "string" } },
        "assignedToNames": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pendiente", "en_progreso", "finalizada", "bloqueada", "cancelada", "retrasada"] },
        "priority": { "type": "string", "enum": ["baja", "media", "alta", "critica"] },
        "targetDate": { "type": "string" },
        "dateChangeCount": { "type": "number" },
        "notes": { "type": "string" },
        "companyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isEscalated": { "type": "boolean" },
        "escalatedToForumId": { "type": "string" },
        "escalatedBy": { "type": "string" },
        "escalatedByName": { "type": "string" },
        "escalatedAt": { "type": "string" },
        "originForumId": { "type": "string" }
      },
      "required": ["title", "createdBy", "status", "priority", "targetDate", "companyId", "createdAt", "updatedAt"]
    },
    "SubAction": {
      "title": "SubAction",
      "description": "A sub-action belonging to an action plan",
      "type": "object",
      "properties": {
        "actionId": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "currentProposedDate": { "type": "string" },
        "dateHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string" },
              "setAt": { "type": "string" },
              "setBy": { "type": "string" }
            }
          }
        }
      },
      "required": ["actionId", "title", "completed"]
    },
    "ActionCategory": {
      "title": "ActionCategory",
      "description": "A category for action plans",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "companyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "companyId", "createdAt"]
    },
    "Forum": {
      "title": "Forum",
      "description": "Definition of a forum meeting structure",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "teamId": { "type": "string" },
        "teamName": { "type": "string" },
        "companyId": { "type": "string" },
        "frequency": { "type": "string", "enum": ["diaria", "semanal", "mensual", "adhoc"] },
        "estimatedDuration": { "type": "number" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "duration": { "type": "number" },
              "order": { "type": "number" }
            },
            "required": ["id", "title", "order"]
          }
        },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "teamId", "companyId", "frequency", "sections", "createdBy", "createdAt"]
    },
    "ForumSession": {
      "title": "ForumSession",
      "description": "A specific meeting instance of a forum",
      "type": "object",
      "properties": {
        "forumId": { "type": "string" },
        "forumName": { "type": "string" },
        "scheduledAt": { "type": "string" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed", "cancelled"] },
        "attendees": {
          "type": "array",
          "items": {
             "type": "object",
             "properties": {
               "uid": { "type": "string" },
               "name": { "type": "string" },
               "present": { "type": "boolean" },
               "groupId": { "type": "string" },
               "groupName": { "type": "string" },
               "isLeader": { "type": "boolean" }
             },
             "required": ["uid", "name", "present"]
          }
        },
        "currentSectionIndex": { "type": "number" },
        "results": {
           "type": "object",
           "additionalProperties": { "type": "string" }
        },
        "companyId": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["forumId", "forumName", "scheduledAt", "status", "attendees", "currentSectionIndex", "results", "companyId", "createdBy"]
    },
    "Indicator": {
      "title": "Indicator",
      "description": "A performance indicator for a forum",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "formula": { "type": "string" },
        "scopeIds": { "type": "array", "items": { "type": "string" } },
        "scopeNames": { "type": "array", "items": { "type": "string" } },
        "link": { "type": "string" },
        "companyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "companyId", "createdAt"]
    },
    "Incident": {
      "title": "Incident",
      "description": "A record of an incident that needs resolution",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "forumId": { "type": "string" },
        "forumName": { "type": "string" },
        "indicatorId": { "type": "string" },
        "indicatorName": { "type": "string" },
        "attachments": { "type": "array", "items": { "type": "string" } },
        "companyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "status": { "type": "string", "enum": ["abierta", "en_accion", "resuelta"] },
        "actionId": { "type": "string" }
      },
      "required": ["title", "forumId", "companyId", "createdAt", "createdBy"]
    }
  },
  "firestore": {
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Activities"
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Companies"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/teams/{teamId}": {
      "schema": { "$ref": "#/entities/Team" },
      "description": "Teams"
    },
    "/processes/{processId}": {
      "schema": { "$ref": "#/entities/Process" },
      "description": "Processes"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks"
    },
    "/criteria/{criterionId}": {
      "schema": { "$ref": "#/entities/Criterion" },
      "description": "Criteria"
    },
    "/userTaskLevels/{userTaskLevelId}": {
      "schema": { "$ref": "#/entities/UserTaskLevel" },
      "description": "User task levels"
    },
    "/trainingActions/{trainingActionId}": {
      "schema": { "$ref": "#/entities/TrainingAction" },
      "description": "Training actions"
    },
    "/teamTargets/{teamTargetId}": {
      "schema": { "$ref": "#/entities/TeamTarget" },
      "description": "Team targets for tasks"
    },
    "/actionPlans/{actionPlanId}": {
      "schema": { "$ref": "#/entities/ActionPlan" },
      "description": "Action plans"
    },
    "/subActions/{subActionId}": {
      "schema": { "$ref": "#/entities/SubAction" },
      "description": "Sub-actions of action plans"
    },
    "/actionCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/ActionCategory" },
      "description": "Categories for action plans"
    },
    "/forums/{forumId}": {
      "schema": { "$ref": "#/entities/Forum" },
      "description": "Forum definitions"
    },
    "/forumSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ForumSession" },
      "description": "Forum session instances"
    },
    "/indicators/{indicatorId}": {
      "schema": { "$ref": "#/entities/Indicator" },
      "description": "Performance indicators"
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Incidents"
    }
  }
}
