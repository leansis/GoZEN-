rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /tasks/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /standards/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /5s/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
